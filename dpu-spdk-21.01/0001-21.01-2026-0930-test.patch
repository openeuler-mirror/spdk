+
+	w = spdk_jsonrpc_begin_result(request);
+
+	if (smsession->backend->show_iostat_json != NULL) {
+		smsession->backend->show_iostat_json(smsession, scsi_tgt_num, w);
+	}
+
+	ssam_unlock();
+
+	spdk_jsonrpc_end_result(request, w);
+	return 0;
+}
