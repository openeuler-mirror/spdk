+static uint64_t
+ssam_bytes_to_blocks(uint32_t block_size, uint64_t bytes_offset, uint64_t *blocks_offset,
+	uint64_t bytes_num, uint64_t *blocks_num)
+{
+	if (spdk_likely(spdk_u32_is_pow2(block_size))) {
+		uint8_t shift = spdk_u32log2(block_size);
+		*blocks_offset = bytes_offset >> shift;
+		*blocks_num = bytes_num >> shift;
+		return (bytes_offset - (*blocks_offset << shift)) |
+				(bytes_num - (*blocks_num << shift));
+	} else {
+		*blocks_offset = bytes_offset / block_size;
+		*blocks_num = bytes_num / block_size;
+		return (bytes_offset % block_size) | (bytes_num % block_size);
+	}
+}
+
+static int
+ssam_get_scsi_blocks(struct spdk_ssam_scsi_task *task, uint32_t block_size,
+	uint8_t *type, uint64_t *offset_blocks, uint64_t *num_blocks)
+{
+	struct spdk_scsi_task *scsi_task = &task->scsi_task;
+	uint8_t *ssam_scsi_cdb = scsi_task->cdb;
+	uint64_t offset = 0;
+
+	switch (ssam_scsi_cdb[0]) {
+		case SPDK_SBC_READ_6:
+		case SPDK_SBC_WRITE_6:
+			offset = (uint64_t)ssam_scsi_cdb[1] << 16;
+			offset |= (uint64_t)ssam_scsi_cdb[2] << 8;
+			offset |= (uint64_t)ssam_scsi_cdb[3];
+			break;
+
+		case SPDK_SBC_READ_10:
+		case SPDK_SBC_WRITE_10:
+		case SPDK_SBC_READ_12:
+		case SPDK_SBC_WRITE_12:
+			offset = from_be32(&ssam_scsi_cdb[2]);
+			break;
+
+		case SPDK_SBC_READ_16:
+		case SPDK_SBC_WRITE_16:
+			offset = from_be64(&ssam_scsi_cdb[2]);
+			break;
+		
+		default:
+			return -1;
+	}
+
+	if (ssam_bytes_to_blocks(block_size, scsi_task->offset, offset_blocks, scsi_task->length, num_blocks) != 0) {
+		SPDK_ERRLOG("scsi io offset %" PRIu64 " or length %" PRIu32 " is not block multiple\n",
+			scsi_task->offset, scsi_task->length);
+		return -1;
+	}
+
+	*type = ssam_scsi_cdb[0];
+	(*offset_blocks) += offset;
+
+	return 0;
+}
+
+static void
+ssam_scsi_io_crc_print(const char *context, void *arg)
+{
+	uint64_t offset_blocks = 0;
+	uint64_t num_blocks = 0;
+	uint8_t type = 0;
+	struct spdk_ssam_scsi_task *task = (struct spdk_ssam_scsi_task *)arg;
+	struct spdk_bdev *bdev = ssam_scsi_get_bdev(task->smsession, task->tgt_id);
+	uint32_t block_size = spdk_bdev_get_data_block_size(bdev);
+
+	uint32_t crc = spdk_crc32c_update(task->iovs.virt.sges[0].iov_base, task->iovs.virt.sges[0].iov_len, 0);
+
+	if (ssam_get_scsi_blocks(task, block_size, &type, &offset_blocks, &num_blocks) != 0) {
+		return;
+	}
+
+	SPDK_NOTICELOG("ssam crc scsi %s: tid=%u gfunc_id=%u vqid=%u reqid=%u lunid=%d reqtype=0x%x rw=%u"
+		" offset_blocks=%"PRIu64" num_blocks=%"PRIu64" block_size=%"PRIu32" crc=%"PRIu32".\n",
+		context,
+		task->ssmsession->smsession.smdev->tid,
+		task->smsession->gfunc_id,
+		task->io_req->req.cmd.virtio.vq_idx,
+		task->io_req->req.cmd.virtio.req_idx,
+		task->tgt_id,
+		type,
+		task->io_req->req.cmd.writable,
+		offset_blocks,
+		num_blocks,
+		block_size,
+		crc);
+}
+
+static void
+ssam_scsi_stat_statistics(struct spdk_ssam_scsi_task *task)
+{
+#ifdef PERF_STAT
+	if (task->scsi_task.lun == NULL || task->io_req->type == VMIO_TYPE_VIRTIO_SCSI_CTRL ||
+	    task->task_stat.bdev_func_tsc == 0 || task->task_stat.bdev_end_tsc == 0) {
+		return;
+	}
+
+	int32_t lun_id = spdk_scsi_lun_get_id(task->scsi_task.lun);
+	struct ssam_scsi_stat *scsi_stat =
+			&task->ssmsession->scsi_dev_state[task->tgt_id].io_stat[lun_id]->scsi_stat;
+
+	uint64_t dma_tsc = task->task_stat.dma_end_tsc - task->task_stat.dma_start_tsc;
+	uint64_t bdev_tsc = task->task_stat.bdev_end_tsc - task->task_stat.bdev_start_tsc;
+	uint64_t bdev_submit_tsc = task->task_stat.bdev_func_tsc - task->task_stat.bdev_start_tsc;
+	uint64_t complete_tsc = task->task_stat.complete_end_tsc - task->task_stat.complete_start_tsc;
+	uint64_t total_tsc = task->task_stat.complete_end_tsc - task->task_stat.start_tsc;
+
+	struct ssam_io_message *io_cmd = &task->io_req->req.cmd;
+	if (io_cmd->writable) { /* read io */
+		if (task->scsi_task.status == SPDK_SCSI_STATUS_GOOD) {
+			scsi_stat->complete_read_ios++;
+		} else {
+			scsi_stat->err_read_ios++;
+		}
+	} else {
+		if (task->scsi_task.status == SPDK_SCSI_STATUS_GOOD) {
+			scsi_stat->complete_write_ios++;
+		} else {
+			scsi_stat->err_write_ios++;
+		}
+	}
+
+	scsi_stat->dma_tsc += dma_tsc;
+	scsi_stat->bdev_tsc += bdev_tsc;
+	scsi_stat->bdev_submit_tsc += bdev_submit_tsc;
+	scsi_stat->complete_tsc += complete_tsc;
+	scsi_stat->total_tsc += total_tsc;
+	scsi_stat->internel_tsc += total_tsc - complete_tsc - bdev_tsc - dma_tsc;
+	scsi_stat->count += 1;
+#endif
+}
