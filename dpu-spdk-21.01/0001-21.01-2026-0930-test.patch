+	struct spdk_json_write_ctx *w = NULL;
+	struct spdk_ssam_session *smsession = NULL;
+
+	ssam_lock();
+	smsession = ssam_session_find(gfunc_id);
+	if (smsession == NULL) {
+		ssam_unlock();
+		return -ENODEV;
+	} else if (smsession->backend->type != VIRTIO_TYPE_SCSI) {
+		ssam_unlock();
+		return -EINVAL;
