+int
+ssam_dma_data_request(uint16_t tid, struct ssam_dma_request *dma_req)
+{
+	if (dma_req == NULL || dma_req->direction >= SSAM_REQUEST_DATA_MAX) {
+		SPDK_ERRLOG("ssam dma request input paramter error.\n");
+		return -EINVAL;
