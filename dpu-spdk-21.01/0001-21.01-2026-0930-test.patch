+static void
+rpc_ssam_clear_iostat(int typenum)
+{
+	struct spdk_ssam_dev *smdev = NULL;
+	struct spdk_ssam_session *smsession = NULL;
+
+	ssam_lock();
+	smdev = ssam_dev_next(NULL);
+	while (smdev != NULL) {
+		smsession = ssam_sessions_next(smdev->smsessions, NULL);
+		while (smsession != NULL) {
