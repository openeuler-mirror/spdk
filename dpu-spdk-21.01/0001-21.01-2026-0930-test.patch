+static struct spdk_ssam_dev *
+ssam_dev_find(uint16_t tid)
+{
+	struct spdk_ssam_dev *smdev = NULL;
+	struct spdk_ssam_dev *tmp = NULL;
+
+	TAILQ_FOREACH_SAFE(smdev, &g_ssam_devices, tailq, tmp) {
+		if (smdev->tid == tid) {
+			return smdev;
+		}
+	}
+
+	return NULL;
+}
