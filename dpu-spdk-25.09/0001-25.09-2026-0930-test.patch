+int ssam_hotplug_del(uint16_t port_id);
+
+/**
+ * @brief get hot upgrade state
+ * @param void
+ * @return
+ *   - 0:  HPD enable
+ *   - 1:  HPD disable
+ */
+bool ssam_hotplug_enable_check(void);
+
+
+#ifdef __cplusplus
+}
+#endif
