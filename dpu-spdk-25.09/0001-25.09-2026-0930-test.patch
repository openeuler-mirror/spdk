+static void
+ssam_session_remove_io_wait(struct spdk_ssam_dev *smdev,
+			    struct spdk_ssam_session_io_wait *session_io_wait)
+{
+	TAILQ_REMOVE(&smdev->io_wait_queue, session_io_wait, link);
+	smdev->io_wait_cnt--;
+}
