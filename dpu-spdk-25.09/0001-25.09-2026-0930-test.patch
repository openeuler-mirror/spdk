+static int
+ssam_rpc_para_check_name(char *name)
+{
+	uint16_t gfunc_id = ssam_get_gfunc_id_by_name(name);
+	if (gfunc_id == SPDK_INVALID_GFUNC_ID) {
+		return 0;
+	}
+
+	return -EEXIST;
+}
