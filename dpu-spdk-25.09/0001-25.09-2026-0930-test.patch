+	rc = ssam_get_funcid_by_dbdf(dbdf_num, gfunc_id);
+	if (rc != 0) {
+		SPDK_ERRLOG("find gfuncid by dbdf(%u) failed, rc: %d.\n", dbdf_num, rc);
+		return -EINVAL;
+	}
+
+	return 0;
+}
